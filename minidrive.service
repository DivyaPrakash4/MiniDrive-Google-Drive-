[Unit]
Description=MiniDrive Spring Boot Application
After=syslog.target network.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu

# Run the Spring Boot JAR with environment variables or JVM arguments
# Replace <RDS_ENDPOINT> and <RDS_PASSWORD> with your actual RDS values
ExecStart=/usr/bin/java -jar /home/ubuntu/MiniDrive-0.0.1-SNAPSHOT.jar \
  --spring.datasource.url=jdbc:mysql://<RDS_ENDPOINT>:3306/minidrive_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true \
  --spring.datasource.username=admin \
  --spring.datasource.password=<RDS_PASSWORD> \
  --aws.region=ap-south-1 \
  --aws.s3.bucket-name=<YOUR_BUCKET_NAME>

SuccessExitStatus=143
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target

